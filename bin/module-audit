#!/usr/bin/env raku
use v6;

use App::ModuleAudit;
use JSON::Fast;

sub default-db-path(--> Str:D) {
    my Str:D $home = %*ENV<HOME> // $*HOME.Str;
    my Str:D $dir = "{$home}/.module-audit";

    unless $dir.IO.e {
        $dir.IO.mkdir;
    }

    return "{$dir}/module-audit.db";
}

sub print-list-header(--> Nil) {
    say sprintf '%-40s %-18s %-8s %-14s %-18s',
        'NAME',
        'AUTH',
        'API',
        'VERSION',
        'UPGRADE AVAILABLE';
}

sub print-list-row($module --> Nil) {
    my Str:D $auth = $module.auth // '';
    my Str:D $api = $module.api // '';
    my Str:D $ver = $module.ver // '';
    my Str:D $upgrade = $module.has-upgrade ?? 'yes' !! 'no';

    say sprintf '%-40s %-18s %-8s %-14s %-18s',
        $module.name,
        $auth,
        $api,
        $ver,
        $upgrade;
}

sub print-list-summary(@modules --> Nil) {
    my Int:D $total = @modules.elems;
    my Int:D $upgrades = 0;
    my Int:D $up-to-date = 0;
    my Int:D $missing-version = 0;

    for @modules -> $module {
        if $module.has-upgrade {
            $upgrades++;
        }
        else {
            $up-to-date++;
        }

        if not $module.ver.defined or $module.ver.chars == 0 {
            $missing-version++;
        }
    }

    say '';
    say "Summary: total unique installed modules={$total}; "
        ~ "upgrades available={$upgrades}; "
        ~ "up-to-date={$up-to-date}; "
        ~ "missing version={$missing-version}";
}


sub compare-version-text(Str:D $left, Str:D $right --> Int:D) {
    my @left-parts = $left.split(/<[.\-+_]>+/);
    my @right-parts = $right.split(/<[.\-+_]>+/);
    my Int:D $max = @left-parts.elems > @right-parts.elems
        ?? @left-parts.elems
        !! @right-parts.elems;

    for 0 ..^ $max -> $i {
        my Str:D $a = @left-parts[$i] // '0';
        my Str:D $b = @right-parts[$i] // '0';

        if $a ~~ /^ \d+ $/ and $b ~~ /^ \d+ $/ {
            return 1 if $a.Int > $b.Int;
            return -1 if $a.Int < $b.Int;
        }
        else {
            return 1 if $a gt $b;
            return -1 if $a lt $b;
        }
    }

    return 0;
}

sub module-spec-for-version($module, Str:D $version --> Str:D) {
    my Str:D $spec = "{$module.name}:ver<{$version}>";

    if $module.auth.defined and $module.auth.chars > 0 {
        $spec ~= ":auth<{$module.auth}>";
    }

    if $module.api.defined and $module.api.chars > 0 {
        $spec ~= ":api<{$module.api}>";
    }

    return $spec;
}

sub read-module-spec-file(Str:D $file --> Array) {
    my Str:D @specs;

    for $file.IO.lines -> $line {
        my Str:D $trimmed = $line.trim;

        next if $trimmed eq '';
        next if $trimmed.starts-with('#');

        @specs.push($trimmed);
    }

    return @specs.Array;
}

sub run-install(Str:D $spec, Bool:D :$dry-run --> Bool:D) {
    my @cmd = 'zef', 'install', $spec;

    if $dry-run {
        say "[dry-run] " ~ @cmd.join(' ');
        return True;
    }

    my $proc = run |@cmd, :out, :err;
    my Str:D $out = $proc.out.slurp-rest;
    my Str:D $err = $proc.err.slurp-rest;

    print $out if $out.chars > 0;
    note $err if $err.chars > 0;

    return $proc.exitcode == 0;
}

sub confirm-action(Str:D $prompt --> Bool:D) {
    print "{$prompt} [y/N] ";
    my $answer = $*IN.get // '';
    return $answer.lc eq 'y' or $answer.lc eq 'yes';
}

sub run-uninstall(Str:D $spec, Bool:D :$dry-run --> Hash:D) {
    my @cmd = 'zef', 'uninstall', $spec;

    if $dry-run {
        say "[dry-run] " ~ @cmd.join(' ');

        return {
            exitcode => 0,
            out      => '',
            err      => '',
            dry-run  => True,
        };
    }

    my $proc = run |@cmd, :out, :err;
    my Str:D $out = $proc.out.slurp-rest;
    my Str:D $err = $proc.err.slurp-rest;

    print $out if $out.chars > 0;
    note $err if $err.chars > 0;

    return {
        exitcode => $proc.exitcode,
        out      => $out,
        err      => $err,
        dry-run  => False,
    };
}


multi sub MAIN(
    'scan',
    Str:D :$db-path = default-db-path()
) {
    my Int:D $count = scan-and-save(db-path => $db-path);
    say "Saved {$count} module record(s) to {$db-path}";
}

multi sub MAIN(
    'list',
    Str:D :$db-path = default-db-path(),
    Bool:D :$repeat-headings = False
) {
    my @modules = load-installed(db-path => $db-path);
    my @sorted-modules = @modules.sort(*.name);

    print-list-header();

    for @sorted-modules -> $module {
        print-list-row($module);
    }

    if $repeat-headings and @sorted-modules.elems > 0 {
        say '';
        print-list-header();
    }

    print-list-summary(@sorted-modules);
}

multi sub MAIN(
    'check-upgrades',
    Str:D :$db-path = default-db-path(),
    Bool:D :$json = False,
    Bool:D :$quiet = False,
    Bool:D :$upgrades-only = False,
    Bool:D :$apply = False,
    Bool:D :$dry-run = False,
    Str :$log,
    Int:D :$parallel = 4
) {
    my @modules = check-for-upgrades(
        db-path  => $db-path,
        parallel => $parallel,
        :$apply,
        :$dry-run,
    );

    my @lines;

    if $json {
        my @out;

        for @modules.sort(*.name) -> $module {
            @out.push(
                {
                    name               => $module.name,
                    auth               => $module.auth,
                    api                => $module.api,
                    installed-ver      => $module.ver,
                    latest-known-ver   => $module.latest-known-ver,
                    upgrade-available  => $module.has-upgrade,
                }
            );
        }

        say to-json(@out, :pretty);
        return;
    }

    for @modules.sort(*.name) -> $module {
        my Str:D $latest = $module.latest-known-ver // '*';
        my Str:D $flag = $module.has-upgrade ?? 'yes' !! 'no';

        say "{$module.name}\tinstalled={$module.ver // '*'}\tlatest={$latest}\tupgrade={$flag}";
    }
}

multi sub MAIN(
    'report',
    Str:D :$db-path = default-db-path(),
    Bool:D :$upgrades-only = False,
    Int:D :$parallel = 4
) {
    my @modules = check-for-upgrades(
        db-path  => $db-path,
        parallel => $parallel,
    );

    say sprintf '%-35s %-12s %-12s %s', 'Module', 'Installed', 'Latest', 'Status';
    say '-' x 75;

    for @modules.sort(*.name) -> $module {
        next if $upgrades-only and not $module.has-upgrade;

        my Str:D $status = $module.has-upgrade ?? 'UPGRADE AVAILABLE' !! '';
        say sprintf '%-35s %-12s %-12s %s',
            $module.name,
            $module.ver // '*',
            $module.latest-known-ver // '*',
            $status;
    }
}



multi sub MAIN(
    'apply-file',
    Str:D :$file!,
    Bool:D :$interactive = False,
    Bool:D :$dry-run = True,
    Bool:D :$force = False
) {
    if not $file.IO.e {
        die "Module spec file does not exist: {$file}";
    }

    if not $dry-run and not $force {
        die "Refusing to install or update modules without --force. Use --dry-run first, then --force.";
    }

    my @specs = read-module-spec-file($file);

    if @specs.elems == 0 {
        say "No module specs found in {$file}.";
        return;
    }

    my Int:D $total = 0;
    my Int:D $successful = 0;
    my Int:D $failed = 0;
    my Int:D $skipped = 0;

    for @specs -> $spec {
        $total++;

        if $interactive {
            unless confirm-action("Install or update {$spec}?") {
                say "Skipped {$spec}";
                $skipped++;
                next;
            }
        }

        if run-install($spec, :$dry-run) {
            $successful++;
        }
        else {
            $failed++;
        }
    }

    say "";
    say "Apply summary: total={$total}; "
        ~ "successful={$successful}; "
        ~ "failed={$failed}; "
        ~ "skipped={$skipped}; "
        ~ "dry-run={$dry-run}; "
        ~ "interactive={$interactive}";
}

sub fresh-installed-zef-lines(--> Array) {
    my $proc = run 'zef', 'list', '--installed', :out, :err;
    my Str:D $out = $proc.out.slurp-rest;
    my Str:D $err = $proc.err.slurp-rest;

    note $err if $err.chars > 0 and $proc.exitcode != 0;

    my Str:D @lines;

    for $out.lines -> $line {
        my Str:D $trimmed = $line.trim;
        next if $trimmed eq '';
        @lines.push($trimmed);
    }

    return @lines.Array;
}

sub installed-spec-still-present(Str:D $module-name, Str:D $version --> Bool:D) {
    my @lines = fresh-installed-zef-lines();

    for @lines -> $line {
        next unless $line.starts-with($module-name);

        if $line.contains(":ver<{$version}>") {
            return True;
        }

        if $line.contains("({$version})") {
            return True;
        }

        if $line ~~ /^ $module-name \s+ '(' $version ')' / {
            return True;
        }
    }

    return False;
}

multi sub MAIN(
    'prune-versions',
    Str:D :$db-path = default-db-path(),
    Str :$name,
    Bool:D :$all = False,
    Bool:D :$interactive = False,
    Bool:D :$dry-run = True,
    Bool:D :$force = False
) {
    if not $all and not $name.defined {
        die "Specify --name=<module> or --all.";
    }

    if $all and $name.defined {
        die "Use either --name or --all, not both.";
    }

    if not $dry-run and not $force {
        die "Refusing to uninstall without --force. Use --dry-run first, then --force.";
    }

    my @modules = load-installed(db-path => $db-path);
    my %groups;

    for @modules -> $module {
        next unless $module.ver.defined and $module.ver.chars > 0;

        if $name.defined and $module.name ne $name {
            next;
        }

        my Str:D $identity-key = $module.name ~ "	"
            ~ ($module.auth // '') ~ "	"
            ~ ($module.api // '');

        %groups{$identity-key}.push($module);
    }

    if %groups.elems == 0 {
        if $all {
            say "No installed modules with version data found.";
        }
        else {
            say "No installed versions found for {$name}.";
        }

        return;
    }

    my Int:D $groups-seen = 0;
    my Int:D $groups-pruned = 0;
    my Int:D $targets = 0;
    my Int:D $successful = 0;
    my Int:D $already-absent = 0;
    my Int:D $not-verified = 0;
    my Int:D $failed = 0;
    my Int:D $skipped = 0;
    my %attempted-specs;

    for %groups.keys.sort -> $key {
        my @group = %groups{$key}.Array;
        $groups-seen++;

        next if @group.elems <= 1;

        my $latest = @group[0];

        for @group -> $module {
            if compare-version-text($module.ver, $latest.ver) > 0 {
                $latest = $module;
            }
        }

        say "";
        say "Module: {$latest.name}";
        say "Keeping latest: {$latest.name}:ver<{$latest.ver}>";

        $groups-pruned++;

        for @group.sort(*.ver) -> $module {
            next if $module.ver eq $latest.ver;

            my Str:D $spec = module-spec-for-version($module, $module.ver);

            if %attempted-specs{$spec}:exists {
                say "Already attempted {$spec}; skipping duplicate target.";
                $skipped++;
                next;
            }

            %attempted-specs{$spec} = True;
            $targets++;

            if $interactive {
                unless confirm-action("Remove older version {$spec}?") {
                    say "Skipped {$spec}";
                    $skipped++;
                    next;
                }
            }

            if not $dry-run and not installed-spec-still-present($module.name, $module.ver) {
                say "Already absent: {$spec}";
                $already-absent++;
                next;
            }

            my %result = run-uninstall($spec, :$dry-run);

            if $dry-run {
                $successful++;
                next;
            }

            if %result<exitcode> != 0 {
                say "Failed: {$spec} (exit {%result<exitcode>})";
                $failed++;
                next;
            }

            if installed-spec-still-present($module.name, $module.ver) {
                say "Not verified after uninstall: {$spec}";
                $not-verified++;
            }
            else {
                say "Verified removed: {$spec}";
                $successful++;
            }
        }
    }

    say "";
    say "Prune summary: groups checked={$groups-seen}; "
        ~ "groups with older versions={$groups-pruned}; "
        ~ "older versions targeted={$targets}; "
        ~ "successful={$successful}; "
        ~ "already absent={$already-absent}; "
        ~ "not verified={$not-verified}; "
        ~ "failed={$failed}; "
        ~ "skipped={$skipped}; "
        ~ "dry-run={$dry-run}; "
        ~ "interactive={$interactive}";
}

multi sub MAIN(
    'remove',
    Str:D :$db-path = default-db-path(),
    Bool:D :$dry-run = False,
    *@names
) {
    my Int:D $count = remove-modules(
        db-path => $db-path,
        |@names,
        :$dry-run,
    );

    say "Removed {$count} module(s)";
}

multi sub MAIN(
    'downgrade',
    Str:D :$db-path = default-db-path(),
    Bool:D :$dry-run = False,
    Str:D :$name!,
    Str:D :$to!
) {
    my Int:D $count = downgrade-modules(
        db-path => $db-path,
        $name   => $to,
        :$dry-run,
    );

    say "Downgraded {$count} module(s)";
}
